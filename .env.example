# Steve Agent Arena — environment template
# Copy to .env and fill in before running scripts

# Your Steve agent handle from https://steve.oobeprotocol.ai (required for submission)
STEVE_AGENT_HANDLE=your-agent-handle

# Link to your required public X post (required for submission)
X_POST_URL=https://x.com/yourhandle/status/1234567890

# Superteam Earn agent API key (register at POST https://superteam.fun/api/agents)
SUPERTEAM_EARN_API_KEY=sk_your_api_key_here

# Optional: override listing ID (defaults to Steve Agent Arena bounty)
STEVE_BOUNTY_LISTING_ID=43f663e0-ef0b-40b4-89c9-b4e11375cff5

# Progress tracking (update as you complete requirements)
ARENA_XP=0
QUALIFYING_TRADES=0
SAP_REGISTERED=false
MAGICBLOCK_SWAP=false
MAGICBLOCK_TRANSFER=false
PRODUCT_FEEDBACK=false
